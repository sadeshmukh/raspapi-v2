---
import Layout from "../layouts/Layout.astro";
import { getShopItems, getUserBySlackId } from "../lib/airtable";
import { getSession } from "../lib/session";

const session = await getSession(Astro.cookies, import.meta.env.SESSION_SECRET);
if (!session) return Astro.redirect("/auth/login");

const userRecord = await getUserBySlackId(session.slack_id);
const hackatimeConnected = !!userRecord?.hackatime_token;

const raspberryBalance = Math.floor(userRecord?.balance ?? 0);

const adminIds = (import.meta.env.ADMIN_IDS ?? "")
	.split(",")
	.map((s: string) => s.trim())
	.filter(Boolean);
const reviewerIds = (import.meta.env.REVIEWER_IDS ?? "")
	.split(",")
	.map((s: string) => s.trim())
	.filter(Boolean);
const isAdmin = adminIds.includes(session.slack_id);
const isReviewer = reviewerIds.includes(session.slack_id);

const shopItems = await getShopItems();
const featuredItems = shopItems.filter((item) => item.priority);
const regularItems = shopItems.filter((item) => !item.priority);
---

<Layout>
  <main class="page">
    <header class="topbar">
      <div class="profile">
        <img
          class="avatar"
          alt="avatar"
          data-slack-id={session.slack_id}
          style="visibility:hidden"
        />
        <p class="name" data-slack-id={session.slack_id}>&nbsp;</p>
      </div>
      <nav class="primary-actions" aria-label="dashboard navigation">
        <a href="/projects" class="nav-action">my projects</a>
        <a href="/shop/orders" class="nav-action">my orders</a>
        {
          (isAdmin || isReviewer) && (
            <a href="/review" class="nav-action">
              review
            </a>
          )
        }
        {
          isAdmin && (
            <>
              <a href="/admin/fulfillment" class="nav-action">
                fulfillment
              </a>
              <a href="/admin/users" class="nav-action">
                admin
              </a>
            </>
          )
        }
      </nav>
      <div class="account-actions">
        {
          hackatimeConnected ? (
            <span class="hackatime-status">hackatime connected</span>
          ) : (
            <a href="/auth/hackatime" class="hackatime-connect">
              connect hackatime
            </a>
          )
        }
        {userRecord?.row_number && (
          <button class="referral-copy" id="referral-copy-btn"
            data-url={`${import.meta.env.PUBLIC_BASE_URL}/?r=${userRecord.row_number}`}>
            copy referral
          </button>
        )}
        <a href="/auth/logout" class="sign-out">sign out</a>
      </div>
    </header>

    <section class="shop">
      <div class="shop-header">
        <h1 class="shop-title">Shop</h1>
        <span class="balance">{raspberryBalance} raspberries</span>
      </div>

      {
        shopItems.length === 0 ? (
          <p class="empty">no items available</p>
        ) : (
          <>
            {featuredItems.length > 0 && (
              <section class="shop-section">
                <div class="section-heading">
                  <h2>Featured</h2>
                </div>
                <div class="grid grid--featured">
                  {featuredItems.map((item) => {
                    const canAfford = raspberryBalance >= item.price;
                    return (
                      <div class="item item--featured">
                        <div class="item-image">
                          {item.imageUrl ? (
                            <img src={item.imageUrl} alt={item.name} />
                          ) : (
                            <span class="fallback">🍓</span>
                          )}
                        </div>
                        <div class="item-info">
                          <div>
                            <p class="item-name">{item.name}</p>
                            {item.description && (
                              <p class="item-desc">{item.description}</p>
                            )}
                          </div>
                          <div class="item-footer">
                            <p class="item-price">{item.price} raspberries</p>
                            <button
                              class="btn-buy"
                              data-item-id={item.id}
                              data-item-name={item.name}
                              data-item-price={item.price}
                              disabled={!canAfford}
                            >
                              {canAfford ? "buy" : "not enough"}
                            </button>
                          </div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </section>
            )}

            {regularItems.length > 0 && (
              <section class="shop-section">
                {featuredItems.length > 0 && (
                  <div class="section-heading">
                    <h2>All items</h2>
                  </div>
                )}
                <div class="grid">
                  {regularItems.map((item) => {
                    const canAfford = raspberryBalance >= item.price;
                    return (
                      <div class="item">
                        <div class="item-image">
                          {item.imageUrl ? (
                            <img src={item.imageUrl} alt={item.name} />
                          ) : (
                            <span class="fallback">🍓</span>
                          )}
                        </div>
                        <div class="item-info">
                          <div>
                            <p class="item-name">{item.name}</p>
                            {item.description && (
                              <p class="item-desc">{item.description}</p>
                            )}
                          </div>
                          <div class="item-footer">
                            <p class="item-price">{item.price} raspberries</p>
                            <button
                              class="btn-buy"
                              data-item-id={item.id}
                              data-item-name={item.name}
                              data-item-price={item.price}
                              disabled={!canAfford}
                            >
                              {canAfford ? "buy" : "not enough"}
                            </button>
                          </div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </section>
            )}

            {regularItems.length === 0 && featuredItems.length > 0 && (
              <p class="empty">no other items available</p>
            )}
          </>
        )
      }
    </section>
  </main>

  <style>
    .page {
      min-height: 100vh;
      padding: 2rem 2.5rem;
      display: flex;
      flex-direction: column;
      gap: 3rem;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding-left: 7rem;
    }

    .profile {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      object-fit: cover;
      background: #1a1a1a;
      flex-shrink: 0;
    }

    .name {
      font-family: "Syne", sans-serif;
      font-weight: 800;
      font-size: 1rem;
      color: #f5f5f5;
      margin: 0;
    }

    .primary-actions,
    .account-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .primary-actions {
      margin-left: auto;
    }

    .nav-action,
    .referral-copy,
    .sign-out,
    .hackatime-connect {
      font-size: 0.75rem;
      font-family: "Syne", sans-serif;
      font-weight: 700;
      line-height: 1;
      text-decoration: none;
      white-space: nowrap;
    }

    .nav-action {
      color: #8a8a8a;
      border: 1px solid #262626;
      padding: 0.5rem 0.75rem;
    }

    .nav-action:hover {
      border-color: #525252;
      color: #f5f5f5;
    }

    .hackatime-connect {
      color: #f5f5f5;
      background: #c41e3a;
      border: 1px solid #c41e3a;
      padding: 0.55rem 0.8rem;
    }

    .hackatime-connect:hover {
      background: #a91931;
      border-color: #a91931;
    }

    .hackatime-status {
      font-size: 0.75rem;
      color: #737373;
      border: 1px solid #262626;
      padding: 0.5rem 0.7rem;
    }

    .referral-copy,
    .sign-out {
      color: #8a8a8a;
      background: none;
      border: 1px solid transparent;
      padding: 0.5rem 0.65rem;
    }

    .referral-copy {
      cursor: pointer;
    }

    .referral-copy:hover,
    .sign-out:hover {
      color: #f5f5f5;
      border-color: #262626;
    }

    .referral-copy.copied {
      color: #f5f5f5;
    }

    .shop {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .shop-header {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .shop-title {
      font-family: "Syne", sans-serif;
      font-weight: 800;
      font-size: 1.5rem;
      color: #f5f5f5;
      margin: 0;
    }

    .balance {
      font-family: "Syne", sans-serif;
      font-weight: 700;
      font-size: 0.75rem;
      color: #f5f5f5;
      border: 1px solid #262626;
      padding: 0.5rem 0.75rem;
    }

    .empty {
      font-size: 0.875rem;
      color: #737373;
      margin: 0;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
      gap: 1px;
      border: 1px solid #262626;
    }

    .shop-section {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .section-heading h2 {
      font-family: "Syne", sans-serif;
      font-size: 0.75rem;
      font-weight: 800;
      color: #8a8a8a;
      letter-spacing: 0.18em;
      margin: 0;
      text-transform: uppercase;
    }

    .grid--featured {
      grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr));
      border-color: #3a3a3a;
    }

    .item {
      display: flex;
      flex-direction: column;
      border-right: 1px solid #262626;
      border-bottom: 1px solid #262626;
      margin-right: -1px;
      margin-bottom: -1px;
    }

    .item--featured {
      background: #0f0f0f;
      border-color: #3a3a3a;
    }

    .item--featured .item-name {
      font-size: 1.1rem;
    }

    .item-image {
      width: 100%;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      background: #111;
      flex-shrink: 0;
    }

    .item-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .fallback {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 4rem;
    }

    .item-info {
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 0.75rem;
      flex: 1;
    }

    .item-name {
      font-family: "Syne", sans-serif;
      font-weight: 700;
      font-size: 1rem;
      color: #f5f5f5;
      margin: 0 0 0.35rem 0;
    }

    .item-desc {
      font-size: 0.85rem;
      color: #737373;
      margin: 0;
      line-height: 1.5;
    }

    .item-price {
      font-size: 0.8rem;
      color: #c41e3a;
      margin: 0;
      font-family: "Syne", sans-serif;
      font-weight: 700;
    }

    .item-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .btn-buy {
      font-size: 0.7rem;
      font-family: "Syne", sans-serif;
      font-weight: 700;
      background: none;
      border: 1px solid #c41e3a;
      color: #c41e3a;
      padding: 0.25rem 0.75rem;
      cursor: pointer;
      white-space: nowrap;
    }

    .btn-buy:hover:not(:disabled) {
      background: #c41e3a;
      color: #f5f5f5;
    }

    .btn-buy:disabled {
      opacity: 0.4;
      cursor: not-allowed;
      border-color: #525252;
      color: #525252;
    }

    @media (max-width: 768px) {
      .page {
        padding: 1.5rem 1rem;
      }

      .topbar {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.75rem;
        padding-left: 0;
        padding-top: 3.5rem;
      }

      .primary-actions,
      .account-actions {
        flex-wrap: wrap;
        gap: 0.5rem 1rem;
      }

      .primary-actions {
        margin-left: 0;
      }
    }
  </style>

  <script>
    const copyBtn = document.getElementById("referral-copy-btn") as HTMLButtonElement | null;
    if (copyBtn) {
      copyBtn.addEventListener("click", () => {
        navigator.clipboard.writeText(copyBtn.dataset.url ?? "").then(() => {
          copyBtn.textContent = "copied!";
          copyBtn.classList.add("copied");
          setTimeout(() => {
            copyBtn.textContent = "copy referral";
            copyBtn.classList.remove("copied");
          }, 1500);
        });
      });
    }

    document.querySelectorAll<HTMLButtonElement>(".btn-buy").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const itemId = btn.dataset.itemId;
        const itemName = btn.dataset.itemName;
        const itemPrice = btn.dataset.itemPrice;
        if (!itemId) return;

        if (!confirm(`Buy "${itemName}" for ${itemPrice} raspberries?`)) return;

        btn.disabled = true;
        btn.textContent = "buying...";

        try {
          const res = await fetch("/api/shop/buy", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ item_id: itemId }),
          });
          const data = await res.json();
          if (!res.ok) {
            alert(data.error || "Purchase failed");
            btn.disabled = false;
            btn.textContent = "buy";
            return;
          }
          btn.textContent = "purchased!";
          const balanceEl = document.querySelector(".balance");
          if (balanceEl) balanceEl.textContent = `${data.new_balance} raspberries`;
          setTimeout(() => location.reload(), 1000);
        } catch {
          alert("Network error");
          btn.disabled = false;
          btn.textContent = "buy";
        }
      });
    });

    const id =
      document.querySelector<HTMLElement>("[data-slack-id]")?.dataset.slackId;
    if (id) {
      fetch(`https://cachet.dunkirk.sh/users/${id}`)
        .then((r) => (r.ok ? r.json() : null))
        .then((d) => {
          if (!d) return;
          const img =
            document.querySelector<HTMLImageElement>("img[data-slack-id]");
          if (img && d.imageUrl) {
            img.src = d.imageUrl;
            img.style.visibility = "visible";
          }
          const name = document.querySelector<HTMLElement>(
            ".name[data-slack-id]",
          );
          if (name && d.displayName) name.textContent = d.displayName;
        })
        .catch(() => {});
    }
  </script>
</Layout>
