---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="verify-page">
    <section class="verify-panel">
      <p class="eyebrow">IDENTITY VERIFICATION REQUIRED</p>
      <h1>Verify your identity</h1>
      <p class="body">
        RaspAPI is only available to users who have completed identity
        verification through Hack Club Auth. Once you finish that, come back and
        sign in again.
      </p>
      <div class="actions">
        <a
          href="https://auth.hackclub.com"
          target="_blank"
          rel="noopener noreferrer"
          class="primary-link">VERIFY WITH HCA</a
        >
        <a href="/auth/login" class="secondary-link">TRY SIGNING IN AGAIN</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .verify-page {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 7rem 1.5rem 4rem;
    background-image: url("https://www.transparenttextures.com/patterns/axiom-pattern.png");
    background-repeat: repeat;
  }

  .verify-panel {
    width: min(100%, 640px);
    border: 1px solid #262626;
    background: rgba(10, 10, 10, 0.92);
    padding: 2rem;
  }

  .eyebrow {
    margin: 0 0 1rem;
    font-family: "Syne", sans-serif;
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.4em;
    color: #c41e3a;
  }

  h1 {
    margin: 0;
    font-family: "Syne", sans-serif;
    font-weight: 800;
    font-size: clamp(2.25rem, 8vw, 5rem);
    line-height: 0.95;
    color: #f5f5f5;
  }

  .body {
    max-width: 34rem;
    margin: 1.25rem 0 0;
    font-size: 1rem;
    line-height: 1.75;
    color: #d4d4d4;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .primary-link,
  .secondary-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.85rem 1rem;
    border: 2px solid #404040;
    font-family: "Syne", sans-serif;
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
    color: #e5e5e5;
    transition:
      border-color 0.2s,
      color 0.2s,
      background 0.2s;
  }

  .primary-link {
    border-color: #c41e3a;
    background: rgba(196, 30, 58, 0.14);
    color: #fff;
  }

  .primary-link:hover,
  .secondary-link:hover {
    border-color: #c41e3a;
    background: rgba(196, 30, 58, 0.1);
    color: #fff;
  }

  @media (max-width: 520px) {
    .verify-page {
      align-items: flex-start;
      padding-top: 8rem;
    }

    .verify-panel {
      padding: 1.5rem;
    }

    .actions,
    .primary-link,
    .secondary-link {
      width: 100%;
    }
  }
</style>
